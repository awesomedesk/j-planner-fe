# Local Development Environment
# 로컬 개발 환경 설정

# API Base URL - 비워 두면 같은 주소(/api/v1/...)로 부른다 (US-34, 08 13-1: 세션·CSRF 쿠키가 같은 주소에 붙음)
NEXT_PUBLIC_API_BASE_URL=
# 개발 서버가 /api/** 를 넘길 BE 주소 (next.config.mjs rewrites, 서버 쪽에서만 읽음)
API_PROXY_TARGET=http://localhost:8080

# Auth Settings
NEXT_PUBLIC_AUTH_DOMAIN=localhost:3000

# External Services
NEXT_PUBLIC_GOOGLE_CALENDAR_API_KEY=your-google-calendar-api-key-here
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key-here

# Debug Settings
NEXT_PUBLIC_DEBUG_MODE=true
NEXT_PUBLIC_LOG_LEVEL=debug

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# App Settings
NEXT_PUBLIC_APP_VERSION=1.0.0-local
NEXT_PUBLIC_APP_ENV=local
