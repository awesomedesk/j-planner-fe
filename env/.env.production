# Production Environment
# 프로덕션 환경 설정

# API Base URL
NEXT_PUBLIC_API_BASE_URL=https://api.j-planner.com/api

# Auth Settings
NEXT_PUBLIC_AUTH_DOMAIN=j-planner.com

# External Services
NEXT_PUBLIC_GOOGLE_CALENDAR_API_KEY=prod-google-calendar-api-key
NEXT_PUBLIC_FIREBASE_API_KEY=prod-firebase-api-key

# Debug Settings
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_LOG_LEVEL=error

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# App Settings
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=production

# Performance Settings
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=true
NEXT_PUBLIC_CACHE_TIMEOUT=3600
