{
  "name": "j-planner-fe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_PUBLIC_APP_ENV=test next dev",
    "dev:local": "NEXT_PUBLIC_APP_ENV=local next dev",
    "dev:test": "NEXT_PUBLIC_APP_ENV=test next dev",
    "dev:prod": "NODE_ENV=production NEXT_PUBLIC_APP_ENV=production next dev",
    "build": "NEXT_PUBLIC_APP_ENV=test next build",
    "build:local": "NEXT_PUBLIC_APP_ENV=local next build",
    "build:test": "NEXT_PUBLIC_APP_ENV=test next build",
    "build:prod": "NODE_ENV=production NEXT_PUBLIC_APP_ENV=production next build",
    "start": "NEXT_PUBLIC_APP_ENV=test next start",
    "start:local": "NEXT_PUBLIC_APP_ENV=local next start",
    "start:test": "NEXT_PUBLIC_APP_ENV=test next start",
    "start:prod": "NODE_ENV=production NEXT_PUBLIC_APP_ENV=production next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:types": "npx -y openapi-typescript@7.13.0 ../j-planner-product/08-openapi.yaml -o types/api/schema.d.ts",
    "env:setup": "cp env/.env.example env/.env.local",
    "env:validate": "echo \"Environment validation: Run 'npm run dev' to test environment loading\""
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "date-fns": "^4.1.0",
    "next": "^16.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^25.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  }
}
