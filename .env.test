# Test Environment
# 테스트 환경 설정

# API Base URL - /j-planner/v1 경로는 포함하지 않음 (API 클라이언트에서 엔드포인트에 포함)
NEXT_PUBLIC_API_BASE_URL=https://test-api.j-planner.com

# Auth Settings
NEXT_PUBLIC_AUTH_DOMAIN=test.j-planner.com

# External Services
NEXT_PUBLIC_GOOGLE_CALENDAR_API_KEY=test-google-calendar-api-key
NEXT_PUBLIC_FIREBASE_API_KEY=test-firebase-api-key

# Debug Settings
NEXT_PUBLIC_DEBUG_MODE=true
NEXT_PUBLIC_LOG_LEVEL=info

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# App Settings
NEXT_PUBLIC_APP_VERSION=1.0.0-test
NEXT_PUBLIC_APP_ENV=test

# Test Specific Settings
NEXT_PUBLIC_MOCK_API=false
NEXT_PUBLIC_TEST_USER_EMAIL=test@j-planner.com
